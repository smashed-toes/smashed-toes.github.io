---
interface Props {
  url: string;
  title: string;
  description?: string;
}

const { url, title, description } = Astro.props;
const embedUrl = url.replace("watch?v=", "embed/");
---

<div class="mb-8 w-full">
  <h2 class="mb-4 text-center text-3xl font-bold text-white">{title}</h2>
  <iframe
    class="aspect-video w-full rounded-2xl"
    src={embedUrl}
    title={title}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
  {description && <p class="mt-2 font-bold text-xl w-full text-white">{description}</p>}
</div>
