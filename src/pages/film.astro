---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import filmData from "../data/film.json";
---

<Layout title="Film - Sam Masto">
  <div class="w-full flex flex-col items-center justify-center text-white">
    <h1 class="text-5xl font-bold font-heading">Film</h1>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
      {
        filmData.map((film) => (
          <ProjectCard
            image={film.image}
            title={film.title}
            description={film.description}
            url={film.url}
            role={film.role}
          />
        ))
      }
    </div>
  </div>
</Layout>
